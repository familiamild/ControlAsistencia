@{
    ViewData["Title"] = "Inicio - Control de Asistencia UBA";
}

<!-- Banner Principal Institucional -->
<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border-start border-5 border-primary">
    <div class="container-fluid py-2">
        <span class="badge bg-primary mb-2 text-uppercase fw-bold px-3 py-2 fs-6">
            Universidad de Buenos Aires
        </span>
        <h1 class="display-5 fw-bold text-dark">Sistema de Control de Asistencia</h1>
        <p class="col-md-10 fs-5 text-muted mt-2">
            Plataforma académica para la gestión de presentismo docente, validación de firmas mediante claves temporales y emisión de reportes operativos.
        </p>
        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-primary btn-lg shadow-sm px-4" asp-controller="Asistencia" asp-action="Index">
                Marcar Asistencia
            </a>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Docentes" asp-action="Index">
                Ver Docentes
            </a>
        </div>
    </div>
</div>

<!-- Tarjetas de Accesos Rápidos -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 py-2">
    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="display-6 text-primary mb-2">📋</div>
                    <h5 class="card-title fw-bold">Marcar Asistencia</h5>
                    <p class="card-text text-muted small">Registro en aula mediante código de autorización asignado.</p>
                </div>
                <a asp-controller="Asistencia" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mt-3">Ingresar</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="display-6 text-success mb-2">👨‍🏫</div>
                    <h5 class="card-title fw-bold">Gestión Docente</h5>
                    <p class="card-text text-muted small">Padrón de profesores, asignación de materias y legajos.</p>
                </div>
                <a asp-controller="Docentes" asp-action="Index" class="btn btn-outline-success btn-sm w-100 mt-3">Ver Docentes</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="display-6 text-warning mb-2">🔑</div>
                    <h5 class="card-title fw-bold">Generar Claves</h5>
                    <p class="card-text text-muted small">Módulo administrativo para emisión de tokens de validación.</p>
                </div>
                <a asp-controller="Admin" asp-action="GenerarCodigo" class="btn btn-outline-warning text-dark btn-sm w-100 mt-3">Generar Clave</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="display-6 text-info mb-2">📊</div>
                    <h5 class="card-title fw-bold">Informes</h5>
                    <p class="card-text text-muted small">Consolidados de presentismo, ausentismo y descargas de planillas.</p>
                </div>
                <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-info text-dark btn-sm w-100 mt-3">Ver Reportes</a>
            </div>
        </div>
    </div>
</div>