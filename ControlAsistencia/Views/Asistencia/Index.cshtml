@{
    ViewData["Title"] = "Marcar Asistencia";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4 text-center">Marcar Asistencia</h3>

                <div id="alertaMensaje" class="alert d-none" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label">DNI o Legajo</label>
                    <div class="input-group">
                        <input type="text" id="dniInput" class="form-control" placeholder="Ingrese su DNI o legajo" />
                        <button type="button" id="btnBuscar" class="btn btn-primary">Buscar</button>
                    </div>
                </div>

                <div class="mb-3" id="grupoCurso" style="display:none;">
                    <label class="form-label">Curso</label>
                    <select id="cursoSelect" class="form-select"></select>
                </div>

                <div class="mb-3" id="grupoCodigo" style="display:none;">
                    <label class="form-label">Código de autorización</label>
                    <input type="text" id="codigoInput" class="form-control" placeholder="Ingrese el código" />
                </div>

                <button type="button" id="btnMarcar" class="btn btn-success w-100" style="display:none;">
                    Marcar Asistencia
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function mostrarMensaje(texto, tipo) {
                $("#alertaMensaje")
                    .removeClass("d-none alert-success alert-danger")
                    .addClass("alert-" + tipo)
                    .text(texto);
            }

            function ocultarMensaje() {
                $("#alertaMensaje").addClass("d-none");
            }

            $("#btnBuscar").on("click", function () {
                ocultarMensaje();
                var dni = $("#dniInput").val().trim();

                if (!dni) {
                    mostrarMensaje("Ingrese un DNI o legajo.", "danger");
                    return;
                }

                $("#grupoCurso").hide();
                $("#grupoCodigo").hide();
                $("#btnMarcar").hide();
                $("#cursoSelect").empty();

                $.ajax({
                    url: "/Asistencia/ObtenerCursosPorDni",
                    type: "GET",
                    data: { dni: dni },
                    success: function (cursos) {
                        if (!cursos || cursos.length === 0) {
                            mostrarMensaje("DNI no registrado o sin cursos asignados.", "danger");
                            return;
                        }

                        $.each(cursos, function (i, curso) {
                            $("#cursoSelect").append(
                                $("<option></option>").val(curso.id).text(curso.descripcion)
                            );
                        });

                        $("#grupoCurso").show();
                        $("#grupoCodigo").show();
                        $("#btnMarcar").show();
                    },
                    error: function (xhr) {
                        if (xhr.status === 404) {
                            mostrarMensaje("DNI no registrado o sin cursos asignados.", "danger");
                        } else {
                            mostrarMensaje("Ocurrió un error al buscar el DNI.", "danger");
                        }
                    }
                });
            });

            $("#btnMarcar").on("click", function () {
                ocultarMensaje();

                var dni = $("#dniInput").val().trim();
                var cursoId = $("#cursoSelect").val();
                var codigo = $("#codigoInput").val().trim();

                if (!codigo) {
                    mostrarMensaje("Ingrese el código de autorización.", "danger");
                    return;
                }

                $("#btnMarcar").prop("disabled", true);

                $.ajax({
                    url: "/Asistencia/Marcar",
                    type: "POST",
                    data: { dni: dni, cursoId: cursoId, codigo: codigo },
                    success: function (resp) {
                        $("#btnMarcar").prop("disabled", false);
                        if (resp.exito) {
                            mostrarMensaje(resp.mensaje, "success");
                            $("#codigoInput").val("");
                        } else {
                            mostrarMensaje(resp.mensaje, "danger");
                        }
                    },
                    error: function () {
                        $("#btnMarcar").prop("disabled", false);
                        mostrarMensaje("Ocurrió un error al registrar la asistencia.", "danger");
                    }
                });
            });
        });
    </script>
}
