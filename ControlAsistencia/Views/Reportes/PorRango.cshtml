@model IEnumerable<ControlAsistencia.Models.RegistroAsistencia>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Reporte General de Asistencia</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al Menú</a>
    </div>

    <form method="get" class="card card-body bg-light mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Fecha Desde</label>
                <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha Hasta</label>
                <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Docente</th>
                    <th>Legajo</th>
                    <th>Materia / Curso</th>
                    <th>Código Utilizado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No se encontraron registros para el rango seleccionado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.FechaHora.AddHours(-3).ToString("dd/MM/yyyy HH:mm") hs</td>
                            <td>@r.Docente?.Apellido, @r.Docente?.Nombre</td>
                            <td>@r.Docente?.Legajo</td>
                            <td>@r.Curso?.Materia (@r.Curso?.CodigoCurso)</td>
                            <td><code>@r.CodigoUtilizado</code></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
