@{
    ViewData["Title"] = "Generar Código";
}

<div class="container mt-4">
    <h2>Generar Código de Autorización</h2>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (ViewBag.CodigoGenerado != null)
    {
        <div class="alert alert-success">
            <h4>¡Código generado!</h4>
            <span class="display-4 font-weight-bold">@ViewBag.CodigoGenerado</span>
        </div>
    }

    <form asp-action="GenerarCodigo" method="post" class="mt-3" style="max-width: 400px;">
        <div class="mb-3">
            <label for="clave" class="form-label">Clave Administrador</label>
            <input type="password" class="form-control" id="clave" name="clave" placeholder="Ingresá la clave" required />
        </div>
        <button type="submit" class="btn btn-primary">Generar Nuevo Código</button>
    </form>
</div>